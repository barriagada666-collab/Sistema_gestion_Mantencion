<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
    <RootNamespace>mantencion</RootNamespace>
    <AssemblyName>Sistema de Gestion Mantencion</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <MyType>WindowsForms</MyType>
    <StartupObject>mantencion.My.MyApplication</StartupObject>
    <ApplicationIcon>icons\app_icon.ico</ApplicationIcon>
    <ApplicationManifest>My Project\app.manifest</ApplicationManifest>

    <!-- Opciones del compilador VB -->
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <OptionStrict>Off</OptionStrict>
    <OptionInfer>On</OptionInfer>

    <!-- La información del ensamblado se mantiene en My Project\AssemblyInfo.vb -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>

    <!-- Habilita la deserialización segura de BinaryFormatter para recursos ResX heredados en .NET 8 -->
    <EnableUnsafeBinaryFormatterSerialization>true</EnableUnsafeBinaryFormatterSerialization>

    <!-- Habilita compilación cruzada en Linux/macOS sin advertencias -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <!-- Silencia advertencias obsoletas de VB, compatibilidad de plataforma y serialización para compilación 100% limpia -->
    <NoWarn>41999,42016,42017,42018,42019,42020,42021,42022,42032,42036,SYSLIB0051,CA1416</NoWarn>

    <!-- Metadatos de GitHub Packages / NuGet -->
    <PackageId>Sistema.Gestion.Mantencion</PackageId>
    <Version>2026.1.0</Version>
    <Authors>Boris Arriagada</Authors>
    <Company>Cambiaso Hnos S.A.C.</Company>
    <Product>Sistema de Gestión Departamento Mantención</Product>
    <Description>Sistema CMMS de Gestión de Mantención Industrial para Cambiaso Hnos. S.A.C. Control integral de órdenes de trabajo (OT), mantención preventiva (MP), carta Gantt, activos técnicos, turnos de personal y reportabilidad avanzada (.NET 8 LTS Windows y macOS).</Description>
    <PackageProjectUrl>https://github.com/barriagada666-collab/Sistema_gestion_Mantencion</PackageProjectUrl>
    <RepositoryUrl>https://github.com/barriagada666-collab/Sistema_gestion_Mantencion</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>Versión 2026.1 LTS con soporte multiplataforma (.NET 8 Windows y macOS vía Whisky), iconografía vectorial Lucide HD, optimización de velocidad de carga y conexiones SQL Server con pooling precalentado.</PackageReleaseNotes>
    <PackageTags>mantencion;gestion;industrial;cambiaso;cmms;mantenimiento;ot;preventivo;sqlserver;net8;windows;macos</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageIcon>app_icon_rounded.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
    <None Include="icons\app_icon_rounded.png" Pack="true" PackagePath="\" />
  </ItemGroup>

  <!-- Importaciones globales del proyecto (My Project -> Referencias) -->
  <ItemGroup>
    <Import Include="Microsoft.VisualBasic" />
    <Import Include="System" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Linq" />
    <Import Include="System.Xml.Linq" />
  </ItemGroup>

  <!-- Paquetes NuGet oficiales para .NET 8 -->
  <ItemGroup>
    <PackageReference Include="System.Data.SqlClient" Version="4.8.6" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="8.0.1" />
    <PackageReference Include="Microsoft.Office.Interop.Excel" Version="15.0.4795.1001" />
    <PackageReference Include="MicrosoftOfficeCore" Version="15.0.0" NoWarn="NU1701" />
    <PackageReference Include="iTextSharp.LGPLv2.Core" Version="3.4.22" />
  </ItemGroup>

  <!-- Generadores de código para My Project -->
  <ItemGroup>
    <Compile Update="My Project\Application.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Application.myapp</DependentUpon>
      <DesignTime>True</DesignTime>
    </Compile>
    <Compile Update="My Project\Resources.Designer.vb">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Update="My Project\Settings.Designer.vb">
      <AutoGen>True</AutoGen>
      <DependentUpon>Settings.settings</DependentUpon>
      <DesignTimeSharedInput>True</DesignTimeSharedInput>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <None Update="My Project\Application.myapp">
      <Generator>MyApplicationCodeGenerator</Generator>
      <LastGenOutput>Application.Designer.vb</LastGenOutput>
    </None>
    <None Update="My Project\Settings.settings">
      <CustomToolNamespace>My</CustomToolNamespace>
      <Generator>SettingsSingleFileGenerator</Generator>
      <LastGenOutput>Settings.Designer.vb</LastGenOutput>
    </None>
  </ItemGroup>

  <!-- Plantillas Excel de Informes en la raíz de salida -->
  <ItemGroup>
    <Content Include="plantillas\inf_ot.xls">
      <Link>inf_ot.xls</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="plantillas\inf_MP.xls">
      <Link>inf_MP.xls</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="plantillas\inf_listado_ciclo_mp.xls">
      <Link>inf_listado_ciclo_mp.xls</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="plantillas\inf_estadistico.xls">
      <Link>inf_estadistico.xls</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="plantillas\inf_datos_tecnicos.xls">
      <Link>inf_datos_tecnicos.xls</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="plantillas\inf_auditoria.xls">
      <Link>inf_auditoria.xls</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="plantillas\inf_gantt.xls">
      <Link>inf_gantt.xls</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="plantillas\InfGantt.xls">
      <Link>InfGantt.xls</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
