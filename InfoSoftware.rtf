\pard\sa200\sl276\slmult1\b\f0\fs28\cf1 SISTEMA DE GESTI\'d3N DEPARTAMENTO MANTENCI\'d3N\par
\b0\fs20\cf2 Cambiaso Hnos. S.A.C. - Versi\'f3n 2026.1\par
\cf3\fs18 Actualizado: Noviembre 2026\par
\v0\par
\cf1\b\fs22 \'bfQu\'e9 es este software?\par
\b0\fs19 El \b Sistema de Gesti\'f3n Mantenci\'f3n\b0  es la plataforma integral desarrollada para la administraci\'f3n, planificaci\'f3n, registro y control estad\'edstico de todas las actividades de mantenimiento industrial de \b Cambiaso Hnos. S.A.C.\b0\par
\par
\cf1\b\fs22 M\'f3dulos y Funcionalidades Principales:\par
\b0\fs19\par
\bullet  \b Gesti\'f3n de \'d3rdenes de Trabajo (OT):\b0  Emisi\'f3n, seguimiento y cierre de \'f3rdenes de trabajo correctivas y programadas. Registro de personal t\'e9cnico, insumos, repuestos y detalle de actividades realizadas.\par
\par
\bullet  \b Mantenimiento Preventivo (MP):\b0  Programaci\'f3n por frecuencia en horas, gesti\'f3n de ciclos operativos, control de pautas preventivas y seguimiento de ejecuci\'f3n por m\'e1quina y componente.\par
\par
\bullet  \b Informes y Estad\'edsticas Avanzadas:\b0  An\'e1lisis jer\'e1rquico recursivo de fallas por Planta, Secci\'f3n, M\'e1quina y Componente. Ranking de intervenciones por personal, c\'e1lculo de horas de detenci\'f3n y porcentajes de cumplimiento.\par
\par
\bullet  \b Carta Gantt y Planificaci\'f3n:\b0  Visualizaci\'f3n temporal de actividades y exportaci\'f3n din\'e1mica a planillas Excel institucionales.\par
\par
\bullet  \b Mantenedores del Sistema:\b0  Administraci\'f3n centralizada del \'e1rbol de activos industriales, secciones, inventario de repuestos y usuarios del sistema.\par
\par
\bullet  \b Auditor\'eda y Seguridad:\b0  Trazabilidad completa de operaciones y control de eventos por usuario.\par
\par
\cf1\b\fs22 Requisitos de Operaci\'f3n:\par
\b0\fs19\par
1. Conexi\'f3n de red activa hacia el servidor de base de datos corporativo (\b SrvMagicInfo\b0 ).\par
2. Microsoft Excel instalado en el equipo para la generaci\'f3n y apertura de informes en formato .xls.\par
3. Microsoft .NET Framework 4.0 o superior instalado en el sistema operativo.\par
\par
\cf2\i Presione "Siguiente" para continuar con la selecci\'f3n de destino e instalaci\'f3n.\i0\cf0\par
