\pard\sa160\sl280\slmult1\b\f0\fs28\cf2 SISTEMA DE GESTI\'d3N DEPARTAMENTO MANTENCI\'d3N\par
\b0\fs20\cf3 Cambiaso Hnos. S.A.C. \endash  Divisi\'f3n de Mantenci\'f3n Industrial\par
\cf4\fs18 Versi\'f3n 2026.2.1 LTS \endash  Autocontenido (.NET 8 x64)\par
\v0\par
\cf1\b\fs22 1. Descripci\'f3n General\par
\b0\fs19 Plataforma corporativa de gesti\'f3n de mantenimiento industrial para planificar, registrar y controlar \'f3rdenes de trabajo, mantenciones preventivas, activos, personal y reportes operativos de \b Cambiaso Hnos. S.A.C.\b0\par
\par
\cf1\b\fs22 2. M\'f3dulos Principales\par
\b0\fs19\par
\bullet  \b \'d3rdenes de Trabajo (OT):\b0  Registro, asignaci\'f3n t\'e9cnica, tiempos de detenci\'f3n, repuestos y cierre operativo.\par
\bullet  \b Mantenci\'f3n Preventiva y Carta Gantt:\b0  Pautas preventivas, ciclos programados y seguimiento visual por equipo.\par
\bullet  \b Activos, Personal y Turnos:\b0  Estructura jer\'e1rquica de equipos, fichas t\'e9cnicas, dotaci\'f3n y calendarios.\par
\bullet  \b Informes y Estad\'edsticas:\b0  Consultas por rango de fechas con exportaci\'f3n integrada a Excel y PDF.\par
\bullet  \b Usuarios, Perfiles y Auditor\'eda:\b0  Control de accesos por perfil y trazabilidad de operaciones.\par
\par
\cf1\b\fs22 3. Requisitos del Equipo Cliente\par
\b0\fs19\par
\bullet  \b Sistema Operativo:\b0  Windows 10 o Windows 11 (64 bits).\par
\bullet  \b Entorno Autocontenido:\b0  Incluye todo lo necesario para ejecutarse, sin requerir descargas adicionales de .NET ni de terceros.\par
\bullet  \b Conectividad:\b0  Acceso de red al servidor SQL corporativo (configurable dentro de la aplicaci\'f3n por un usuario administrador).\par
\par
\cf2\i Presione el bot\'f3n "Siguiente" para continuar con la instalaci\'f3n.\i0\cf0\par
